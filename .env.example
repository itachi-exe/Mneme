# Mneme environment — copy to .env (never commit secrets)

# --- Runtime ---
MNEME_API_PORT=3011
MNEME_WEB_PORT=3010
MNEME_DATA_DIR=./data
MNEME_NETWORK=galileo

# --- 0G Chain ---
# Galileo testnet (16602) or Aristotle mainnet (16661)
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_CHAIN_ID=16602
# Deployer / writer key. Leave empty to run in local-only mode.
OG_PRIVATE_KEY=
# Set after `forge script script/Deploy.s.sol`
MNEME_FACTORY_ADDRESS=
MNEME_SNAPSHOT_ADDRESS=

# --- 0G Storage ---
OG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
OG_STORAGE_FLOW=0x22E03a6A89B950F1c82ec5e74F8eCa321a105296
# Optional dedicated KV node. Leave empty to skip live KV writes.
OG_KV_NODE_URL=

# --- 0G Compute (Router, recommended) ---
# Create a key at https://pc.0g.ai with inference permission.
OG_COMPUTE_API_KEY=
OG_COMPUTE_BASE_URL=https://router-api.0g.ai/v1
OG_COMPUTE_MODEL=zai-org/GLM-5-FP8

# --- Optional: ERC-7857 Agentic ID registry ---
# If unset, Mneme accepts local agent IDs and still records provenance.
AGENTIC_ID_REGISTRY=

# --- Demo ---
MNEME_DEMO_POOL=research-swarm
